# === Core ===
FLASK_SECRET_KEY=change-me-to-a-random-secret
SESSION_SECRET_KEY=change-me-to-a-random-secret
AUTH_ENABLED=true

# === LLM — DeepSeek (single provider) ===
# Register at https://platform.deepseek.com — free 5M tokens for 30 days
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_ANALYSIS_MODEL=deepseek-v4-flash
DEEPSEEK_FORGE_MODEL=deepseek-v4-pro

# === Social Media APIs ===
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Fortis/1.0
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
INSTAGRAM_ACCESS_TOKEN=
YOUTUBE_API_KEY=
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
TIKTOK_API_KEY=

# === Geolocation ===
MAXMIND_LICENSE_KEY=
GOOGLE_GEOCODING_API_KEY=
NOMINATIM_USER_AGENT=Fortis/1.0

# === Optional Integrations ===
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
NEWSAPI_KEY=

# === Google OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5000/oauth/callback

# === Google Drive Export ===
GDRIVE_SERVICE_ACCOUNT_KEY=
GDRIVE_FOLDER_ID=

# === Notifications ===
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# === Redis (optional — needed for feed monitors) ===
REDIS_URL=redis://localhost:6379/0

# === ForgeChain ===
FORGE_ENABLED=true
FORGE_CONSENSUS_THRESHOLD=2
FORGE_HEALING_ENABLED=true
FORGE_MAX_PROMPT_LENGTH=50000
FORGE_SAFETY_VETO_THRESHOLD=0.95
FORGE_LLM_VERIFIER_TIMEOUT=15
FORGE_DB_PATH=data/forge_chain.db

# === Knowledge Base ===
KB_RETENTION_DAYS=90
VECTORSTORE_HMAC_KEY=

# === Feed Monitor ===
MONITOR_DEFAULT_INTERVAL=15
MONITOR_MAX_ACTIVE=20
